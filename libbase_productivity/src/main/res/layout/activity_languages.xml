<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/_10sdp"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_gravity="center"
            android:background="@color/transparent"
            android:padding="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <com.jrm.base.tracking.TrackableCardView
                android:visibility="gone"
                android:id="@+id/back_btn"
                android:layout_width="wrap_content"
                app:strokeWidth="0dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/white"
                android:layout_height="wrap_content"
                app:enableTracking="true">
                <LinearLayout
                    android:padding="@dimen/_8sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:src="@drawable/baseline_arrow_back"
                        app:tint="@color/black" />
                </LinearLayout>
            </com.jrm.base.tracking.TrackableCardView>

            <com.jrm.view.gradient.GradientTextView
                android:id="@+id/txt_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wix_madefor_display_bold"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_6sdp"
                android:text="@string/language"
                android:textStyle="bold"
                style="@style/textGradientApp"
                android:textSize="@dimen/_14sdp" />
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/loading_anim"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:scaleX="2"
                android:scaleY="2"
                android:visibility="gone"
                android:layout_alignParentEnd="true"
                app:lottie_rawRes="@raw/ob_insider_loading"
                app:lottie_autoPlay="true"
                android:layout_centerVertical="true"
                android:layout_margin="@dimen/_5sdp"
                app:lottie_loop="true" />
            <com.jrm.base.tracking.TrackableButton
                android:id="@+id/btnNext"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/ob_tick"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@id/indicator_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </LinearLayout>

        <ListView
            android:paddingHorizontal="@dimen/_10sdp"
            android:id="@+id/listview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="0dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="10.0sp"
            android:scrollbars="vertical"
            app:layout_constraintTop_toBottomOf="@+id/topBar"
            tools:layout_editor_absoluteX="0dp"
            tools:listitem="@layout/item_language_button" />

        <com.ads.nomyek_admob.ads_components.ads_native.YNMNativeAdView
            android:id="@+id/nativeAd"
            android:layout_width="match_parent"
            android:layout_height="358dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="0dp"
            app:layoutLoading="@layout/native_shimmer_placeholder" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/loading_popup_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="@dimen/_12sdp"
            app:cardElevation="@dimen/_8sdp"
            android:backgroundTint="@color/white">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/_24sdp">

                <com.airbnb.lottie.LottieAnimationView
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    app:lottie_rawRes="@raw/ob_insider_loading"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true" />

                <TextView
                    android:id="@+id/txt_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:text="Apply your language"
                    android:textColor="#101828"
                    android:textSize="@dimen/_14sdp"
                    android:fontFamily="@font/wix_madefor_display_bold"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
    </FrameLayout>
</layout>