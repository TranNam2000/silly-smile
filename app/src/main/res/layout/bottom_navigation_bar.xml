<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="@drawable/bottom_bar_gradient"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <!-- Home -->
    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_home_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_home"
            android:tint="@color/nav_item_text" />

        <TextView
            android:id="@+id/nav_home_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/wix_madefor_display"
            android:text="Home"
            android:textColor="@color/nav_item_text"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Favorite -->
    <LinearLayout
        android:id="@+id/nav_favorite"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_favorite_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_favorite"
            android:tint="@color/nav_item_text" />

        <TextView
            android:id="@+id/nav_favorite_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/wix_madefor_display"
            android:text="Favorite"
            android:textColor="@color/nav_item_text"
            android:textSize="9sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">


        <androidx.cardview.widget.CardView
            android:id="@+id/nav_add"
            android:layout_width="53dp"
            android:layout_height="53dp"
            android:layout_gravity="center"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp">

            <FrameLayout
                android:id="@+id/nav_add_inner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_purple_button"
                android:clickable="false"
                android:focusable="false">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add"
                    android:tint="@color/white" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- History -->
    <LinearLayout
        android:id="@+id/nav_history"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_history_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_history"
            android:tint="@color/nav_item_text" />

        <TextView
            android:id="@+id/nav_history_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/wix_madefor_display"
            android:text="History"
            android:textColor="@color/nav_item_text"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Setting -->
    <LinearLayout
        android:id="@+id/nav_setting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_setting_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_setting"
            android:tint="@color/nav_item_text" />

        <TextView
            android:id="@+id/nav_setting_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/wix_madefor_display"
            android:text="Setting"
            android:textColor="@color/nav_item_text"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>

